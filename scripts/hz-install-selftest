#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
installer="${repo_root}/hzLinux/airootfs/usr/local/bin/hz-install"

fail() {
    printf 'FAIL: %s\n' "$*" >&2
    exit 1
}

assert_jq() {
    local file="$1"
    shift
    local filter="$1"
    shift
    local message="$1"
    shift
    jq -e "$@" "$filter" "$file" >/dev/null || fail "$message"
}

command -v jq >/dev/null 2>&1 || fail "jq is required for this selftest"

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

out="$tmpdir/rendered"
"$installer" \
    --dry-run \
    --target-disk /dev/testdisk \
    --hostname rgx1gen11 \
    --username rgoswami \
    --timezone America/Chicago \
    --output-dir "$out" >/dev/null

config="$out/user_configuration.json"
creds="$out/user_credentials.json"

test -s "$config" || fail "missing rendered user_configuration.json"
test -s "$creds" || fail "missing rendered user_credentials.json"

jq empty "$config" >/dev/null || fail "config is not valid JSON"
jq empty "$creds" >/dev/null || fail "credentials are not valid JSON"

assert_jq "$config" '.hostname == "rgx1gen11"' "hostname was not rendered"
assert_jq "$config" '.timezone == "America/Chicago"' "timezone was not rendered"
assert_jq "$config" '.bootloader_config.bootloader == "Systemd-boot"' "bootloader was not rendered"
assert_jq "$config" '.disk_config.device_modifications[0].device == "/dev/testdisk"' "target disk was not rendered"
assert_jq "$config" '.disk_encryption.encryption_type == "luks"' "LUKS encryption was not rendered"
assert_jq "$config" '.disk_encryption.partitions[0] == "hz-root"' "root encryption target was not rendered"
assert_jq "$config" '.kernels | index("linux")' "linux kernel missing"
assert_jq "$config" '.kernels | index("linux-lts")' "linux-lts kernel missing"
assert_jq "$config" '.packages | index("chezmoi")' "chezmoi package missing"
assert_jq "$config" '.packages | index("greetd-tuigreet")' "tuigreet package missing"
assert_jq "$config" '.packages | index("xdg-desktop-portal-wlr")' "wlroots portal package missing"
assert_jq "$config" '.packages | index("zram-generator")' "zram package missing"
assert_jq "$config" '.packages | index("tlp")' "tlp package missing"
for pkg in \
    firefox chromium vivaldi obsidian libreoffice-fresh keepassxc obs-studio \
    kooha v4l2loopback-dkms vlc spotify-launcher element-desktop discord \
    thunar flatpak bluez-utils pamixer nm-connection-editor \
    networkmanager-openvpn ripgrep fd btop yazi github-cli glab podman \
    reflector noto-fonts ttf-jetbrains-mono-nerd kanshi; do
    # shellcheck disable=SC2016
    assert_jq "$config" '.packages | index($pkg)' "installed usability package missing: $pkg" --arg pkg "$pkg"
done
if jq -e '.packages | index("kanata")' "$config" >/dev/null; then
    fail "kanata should be installed by the post-install bootstrap"
fi
assert_jq "$config" '.["custom-commands"][] | contains("chezmoi init")' "chezmoi bootstrap command missing"
assert_jq "$creds" '.users[0].username == "rgoswami"' "user credentials were not rendered"
assert_jq "$creds" '.disk_encryption_password == "CHANGEME"' "dry-run disk password placeholder missing"

terra_out="$tmpdir/terra"
"$installer" \
    --dry-run \
    --profile rgam5terra \
    --target-disk /dev/testdisk \
    --username rgoswami \
    --timezone America/Chicago \
    --output-dir "$terra_out" >/dev/null

terra_config="$terra_out/user_configuration.json"
terra_creds="$terra_out/user_credentials.json"

test -s "$terra_config" || fail "missing rgam5terra user_configuration.json"
test -s "$terra_creds" || fail "missing rgam5terra user_credentials.json"

jq empty "$terra_config" >/dev/null || fail "rgam5terra config is not valid JSON"
jq empty "$terra_creds" >/dev/null || fail "rgam5terra credentials are not valid JSON"

assert_jq "$terra_config" '.hostname == "rgam5terra"' "rgam5terra hostname was not rendered"
for pkg in amd-ucode nvidia-open-dkms nvidia-utils nvidia-settings opencl-nvidia tuned tuned-ppd; do
    # shellcheck disable=SC2016
    assert_jq "$terra_config" '.packages | index($pkg)' "rgam5terra package missing: $pkg" --arg pkg "$pkg"
done
for pkg in tlp tlp-rdw thermald; do
    if jq -e --arg pkg "$pkg" '.packages | index($pkg)' "$terra_config" >/dev/null; then
        fail "rgam5terra should not install laptop-only package: $pkg"
    fi
done
assert_jq "$terra_config" '.kernels | index("linux")' "rgam5terra must keep stock linux kernel"
assert_jq "$terra_config" '.kernels | index("linux-lts")' "rgam5terra must keep linux-lts kernel"
# linux-rg is optional until an Arch-capable builder produces prebuilts; Terra boots on stock kernels.
if jq -e '.kernels | index("linux-rg")' "$terra_config" >/dev/null; then
    fail "rgam5terra should not require linux-rg until prebuilts are wired"
fi
assert_jq "$terra_config" 'any(.["custom-commands"][]; contains("machine_name = \"rgam5terra\""))' "rgam5terra machine name missing"
assert_jq "$terra_config" 'any(.["custom-commands"][]; contains("have_cuda = \"yes\""))' "rgam5terra CUDA flag missing"

if "$installer" --dry-run --profile nope --target-disk /dev/testdisk --output-dir "$tmpdir/bad-profile" >/dev/null 2>&1; then
    fail "unsupported profile should fail"
fi

if "$installer" --target-disk /dev/testdisk --output-dir "$tmpdir/nope" </dev/null >/dev/null 2>&1; then
    fail "non-dry-run install should refuse without confirmation"
fi

printf 'ok\n'
