#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
installer="${repo_root}/hzLinux/airootfs/usr/local/bin/hz-install"

fail() {
    printf 'FAIL: %s\n' "$*" >&2
    exit 1
}

need_plan() {
    local file="$1" needle="$2" message="$3"
    grep -F -- "$needle" "$file" >/dev/null || fail "$message"
}

test -x "$installer" || fail "missing hz-install backend: $installer (run make tui)"

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

out="$tmpdir/rendered"
"$installer" \
    --dry-run \
    --target-disk /dev/testdisk \
    --hostname rgx1gen11 \
    --username rgoswami \
    --timezone America/Chicago \
    --output-dir "$out" >/dev/null

plan="$out/install-plan.txt"
test -s "$plan" || fail "missing install-plan.txt"

need_plan "$plan" "no archinstall" "plan should state native Go / no archinstall"
need_plan "$plan" "profile=rgx1gen11" "hostname profile line missing"
need_plan "$plan" "hostname=rgx1gen11" "hostname missing"
need_plan "$plan" "target_disk=/dev/testdisk" "target disk missing"
need_plan "$plan" "type ef00" "ESP ef00 missing"
need_plan "$plan" "LUKS" "LUKS mention missing"
need_plan "$plan" "compress=zstd" "compress=zstd missing"
need_plan "$plan" "noatime" "noatime missing"
need_plan "$plan" "esp_mount=/boot" "ESP mount missing"
need_plan "$plan" "@home" "subvolume @home missing"
need_plan "$plan" "@snapshots" "subvolume @snapshots missing"
need_plan "$plan" "@var_log" "subvolume @var_log missing"
need_plan "$plan" "@cache" "subvolume @cache missing"
need_plan "$plan" "locale=en_US.UTF-8" "locale missing"
need_plan "$plan" "bootloader=systemd-boot" "systemd-boot missing"
need_plan "$plan" "cryptdevice=" "cryptdevice kernel param missing"
need_plan "$plan" "rootflags=subvol=@" "rootflags missing"
need_plan "$plan" "linux linux-lts" "kernels missing"
need_plan "$plan" "  - chezmoi" "chezmoi package missing"
need_plan "$plan" "  - greetd-tuigreet" "tuigreet package missing"
need_plan "$plan" "  - xdg-desktop-portal-wlr" "wlroots portal package missing"
need_plan "$plan" "  - zram-generator" "zram package missing"
need_plan "$plan" "  - tlp" "tlp package missing on rgx1"
need_plan "$plan" "chezmoi init --apply HaoZeke --branch chezmoi" "chezmoi bootstrap missing"
need_plan "$plan" 'key_layout = "colemak"' "chezmoi key layout missing"
need_plan "$plan" 'have_cuda = "no"' "rgx1 cuda flag missing"
need_plan "$plan" "dry-run: no sgdisk" "dry-run guard missing"
need_plan "$plan" "NetworkManager.service" "NetworkManager enable missing"

for pkg in \
    firefox chromium vivaldi obsidian libreoffice-fresh keepassxc obs-studio \
    kooha v4l2loopback-dkms vlc spotify-launcher element-desktop discord \
    thunar flatpak bluez-utils pamixer nm-connection-editor \
    networkmanager-openvpn ripgrep fd btop yazi github-cli glab podman \
    reflector noto-fonts ttf-jetbrains-mono-nerd kanshi; do
    need_plan "$plan" "  - $pkg" "usability package missing: $pkg"
done
if grep -F '  - kanata' "$plan" >/dev/null; then
    fail "kanata should be installed by the post-install bootstrap"
fi

terra_out="$tmpdir/terra"
"$installer" \
    --dry-run \
    --profile rgam5terra \
    --target-disk /dev/testdisk \
    --username rgoswami \
    --timezone America/Chicago \
    --output-dir "$terra_out" >/dev/null

terra_plan="$terra_out/install-plan.txt"
test -s "$terra_plan" || fail "missing rgam5terra install-plan.txt"
need_plan "$terra_plan" "hostname=rgam5terra" "rgam5terra hostname was not set"
for pkg in amd-ucode nvidia-open-dkms nvidia-utils nvidia-settings opencl-nvidia tuned tuned-ppd; do
    need_plan "$terra_plan" "  - $pkg" "rgam5terra package missing: $pkg"
done
for pkg in tlp tlp-rdw thermald; do
    if grep -F "  - $pkg" "$terra_plan" >/dev/null; then
        fail "rgam5terra should not install laptop-only package: $pkg"
    fi
done
need_plan "$terra_plan" "linux linux-lts" "rgam5terra must keep stock kernels"
need_plan "$terra_plan" 'machine_name = "rgam5terra"' "rgam5terra machine name missing"
need_plan "$terra_plan" 'have_cuda = "yes"' "rgam5terra CUDA flag missing"

if "$installer" --dry-run --profile nope --target-disk /dev/testdisk --output-dir "$tmpdir/bad-profile" >/dev/null 2>&1; then
    fail "unsupported profile should fail"
fi

if "$installer" --target-disk /dev/testdisk --output-dir "$tmpdir/nope" </dev/null >/dev/null 2>&1; then
    fail "non-dry-run install should refuse without confirmation/root/destructive arming"
fi
if HZ_INSTALL_ALLOW_DESTRUCTIVE=1 "$installer" --target-disk /dev/testdisk --output-dir "$tmpdir/nope2" </dev/null >/dev/null 2>&1; then
    fail "non-dry-run install should still refuse without root even when armed"
fi

printf 'ok\n'
