#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
checker="${repo_root}/scripts/hzarchiso-aur-repo-check"

fail() {
    printf 'FAIL: %s\n' "$*" >&2
    exit 1
}

write_pkg() {
    local repo_dir="$1" pkg="$2" version="${3:-1-1}"
    local pkgdir
    pkgdir=$(mktemp -d)
    cat >"${pkgdir}/.PKGINFO" <<EOF
pkgname = ${pkg}
pkgver = ${version}
pkgdesc = test package
builddate = 1
packager = hzarchiso selftest
size = 1
arch = any
EOF
    bsdtar --format=mtree --options='!all,use-set,type,uid,gid,mode,time,size,md5,sha256,link' \
        -cf "${pkgdir}/.MTREE" -C "$pkgdir" .PKGINFO
    bsdtar -cf "${repo_dir}/${pkg}-${version}-any.pkg.tar" -C "$pkgdir" .PKGINFO .MTREE
    rm -rf "$pkgdir"
}

assert_fails() {
    local repo_dir="$1" packages_file="$2" pattern="$3"
    local out
    if out=$("$checker" "$repo_dir" "$packages_file" 2>&1); then
        fail "expected check to fail: $pattern"
    fi
    grep -q "$pattern" <<<"$out" || fail "missing failure pattern: $pattern"
}

command -v bsdtar >/dev/null 2>&1 || fail "bsdtar is required"
command -v repo-add >/dev/null 2>&1 || fail "repo-add is required"
test -x "$checker" || fail "missing checker: $checker"

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

repo_dir="${tmpdir}/repo"
packages_file="${tmpdir}/aurpkgs.txt"
mkdir -p "$repo_dir"
cat >"$packages_file" <<'EOF'
ananicy
yay
EOF

assert_fails "$repo_dir" "$packages_file" 'missing repository database'

write_pkg "$repo_dir" ananicy
repo-add -q "${repo_dir}/hzarchiso.db.tar.gz" "${repo_dir}"/*.pkg.tar
assert_fails "$repo_dir" "$packages_file" 'missing package: yay'

write_pkg "$repo_dir" yay
repo-add -q "${repo_dir}/hzarchiso.db.tar.gz" "${repo_dir}/yay-1-1-any.pkg.tar"
"$checker" "$repo_dir" "$packages_file" >/dev/null

printf 'ok\n'
